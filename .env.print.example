# Puerto interno del servidor de Print Studio.
PORT=3000

# URL pública que utiliza el navegador y URL privada accesible desde el contenedor.
OUTLINE_PUBLIC_URL=https://outline.example.com
OUTLINE_INTERNAL_URL=http://outline:3000

# Aplicación OAuth creada en Outline. La URI debe coincidir exactamente.
OUTLINE_AUTHORIZATION_URL=https://outline.example.com/oauth/authorize
OUTLINE_CLIENT_ID=replace-with-outline-oauth-client-id
OUTLINE_CLIENT_SECRET=replace-with-outline-oauth-client-secret
OUTLINE_REDIRECT_URI=https://outline.example.com/print/auth/callback

# Solo se aceptarán sesiones pertenecientes a este workspace de Outline.
OUTLINE_TEAM_ID=replace-with-outline-team-id

# Redis almacena estados OAuth, sesiones y tokens únicamente en el servidor.
REDIS_URL=redis://outline-redis:6379
